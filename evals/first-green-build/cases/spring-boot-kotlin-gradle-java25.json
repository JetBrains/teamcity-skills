{
  "schemaVersion": 1,
  "id": "spring-boot-kotlin-gradle-java25",
  "kind": "first-green-build",
  "status": "draft",
  "skill": "teamcity-first-green-build",
  "prompt": "Set up TeamCity CI on {{teamcity.server}} in project {{teamcity.targetProject}} and get the first build green. This Kotlin/Gradle repository requires Java 25. Run the Gradle build in a Java 25 container on a Docker-capable agent, even if a host JDK 25 is available. Keep Java 25 and repository sources unchanged, import JUnit XML, and publish the application JAR. Verify the actual build before reporting success.",
  "teamcity": {
    "server": "runner-configured",
    "targetProject": "runner-configured"
  },
  "repository": {
    "url": "https://github.com/phoenigm/spring-boot-kotlin-gradle-template.git",
    "revision": "247663dee82c9182215112cc5cdd5255d58eddea",
    "defaultBranch": "master",
    "root": "."
  },
  "stack": {
    "family": "spring-boot",
    "buildTool": "gradle",
    "gradle": "9.2.1",
    "jdk": "25",
    "kotlin": "2.3.0-RC",
    "springBoot": "4.0.0"
  },
  "requestedConfiguration": {
    "format": "yaml",
    "sourcePath": ".teamcity.yml"
  },
  "agentTools": ["Bash", "Read", "Write", "Edit", "Glob", "Grep"],
  "verification": {
    "command": "./gradlew --no-daemon clean build",
    "testReportPaths": [
      "template-app/build/test-results/test/*.xml"
    ],
    "artifactPaths": [
      "template-app/build/libs/*.jar"
    ]
  },
  "expected": {
    "configurationValidated": true,
    "testsExecutedAndReported": true,
    "artifactsPublished": true,
    "sourceMutations": "none",
    "toolchain": {
      "jdk": "25"
    },
    "requiredContainerImage": "(?i)(?:temurin|openjdk|jdk)[^\\n]*25|25[^\\n]*(?:jdk|java)",
    "firstBuild": "SUCCESS"
  }
}
