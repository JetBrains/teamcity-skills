{
  "schemaVersion": 1,
  "id": "clean-spring-boot-maven",
  "kind": "first-green-build",
  "status": "active",
  "skill": "teamcity-first-green-build",
  "prompt": "Set up TeamCity CI on {{teamcity.server}} in project {{teamcity.targetProject}} and get the first build green. Keep the repository source unchanged, use Maven verification on an explicit Java 21 image, import the Maven JUnit XML reports, and publish the application JAR.",
  "teamcity": {
    "server": "runner-configured",
    "targetProject": "runner-configured"
  },
  "repository": {
    "url": "https://github.com/kawser2133/clean-spring-boot-project.git",
    "revision": "315ca51dcb0ec25f2cce8f99fa239ec23717f3f6",
    "defaultBranch": "development",
    "root": "."
  },
  "stack": {
    "family": "spring-boot",
    "buildTool": "maven",
    "maven": "3.x",
    "jdk": "21",
    "springBoot": "3.2.5"
  },
  "requestedConfiguration": {
    "format": "yaml",
    "sourcePath": ".teamcity.yml"
  },
  "agentTools": ["Bash", "Read", "Write", "Edit", "Glob", "Grep"],
  "verification": {
    "command": "./mvnw -B -ntp clean verify",
    "testReportPaths": [
      "target/surefire-reports/*.xml"
    ],
    "artifactPaths": [
      "target/*.jar"
    ]
  },
  "expected": {
    "configurationValidated": true,
    "testsExecutedAndReported": true,
    "artifactsPublished": true,
    "sourceMutations": "none",
    "toolchain": {
      "jdk": "21"
    },
    "firstBuild": "SUCCESS"
  }
}
