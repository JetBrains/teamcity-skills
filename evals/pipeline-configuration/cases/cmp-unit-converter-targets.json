{
  "schemaVersion": 1,
  "id": "cmp-unit-converter-targets",
  "kind": "pipeline-configuration",
  "status": "draft",
  "skill": "teamcity-first-green-build",
  "prompt": "Create the TeamCity pipeline configuration on {{teamcity.server}} in project {{teamcity.targetProject}} for this repository: create the VCS root and the pipeline, validate the configuration against the server, and stop there. Do not queue any build. The teamcity CLI is installed and authenticated against that server.",
  "teamcity": {
    "server": "runner-configured",
    "targetProject": "runner-configured"
  },
  "repository": {
    "url": "https://github.com/tkuenneth/CMP-Unit-Converter.git",
    "revision": "fd427a05fd8fd27bef0bbef1971ec5397e12de9d",
    "defaultBranch": "main",
    "root": "."
  },
  "stack": {
    "family": "compose-multiplatform",
    "buildTool": "gradle",
    "gradle": "9.7.0",
    "jdk": "17",
    "kotlin": "2.4.10"
  },
  "requestedConfiguration": {
    "format": "yaml",
    "sourcePath": ".teamcity.yml"
  },
  "agentTools": ["Bash", "Read", "Write", "Edit", "Glob", "Grep"],
  "expected": {
    "configurationValidated": true,
    "sourceMutations": "none",
    "minimumJobs": 3,
    "expectedJobCount": 3,
    "requiredStepTypes": ["gradle"],
    "requiredArtifactRules": ["\\.apk"],
    "requiredAgentRequirements": ["(?i)mac|darwin|osx"],
    "requiredJobs": [
      {
        "jobMatches": "(?i)android",
        "requiredStepTypes": ["gradle"],
        "requiredArtifactRules": ["(?i)\\.apk"]
      },
      {
        "jobMatches": "(?i)ios",
        "requiredStepTypes": ["gradle"],
        "requiredAgentRequirements": ["(?i)mac|darwin|osx"]
      },
      {
        "jobMatches": "(?i)desktop",
        "requiredStepTypes": ["gradle"]
      }
    ]
  }
}
