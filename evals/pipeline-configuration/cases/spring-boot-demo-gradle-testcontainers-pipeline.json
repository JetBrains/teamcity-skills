{
  "schemaVersion": 1,
  "id": "spring-boot-demo-gradle-testcontainers-pipeline",
  "kind": "pipeline-configuration",
  "status": "active",
  "skill": "teamcity-first-green-build",
  "prompt": "Create and server-validate the TeamCity pipeline configuration on {{teamcity.server}} in project {{teamcity.targetProject}} for this Kotlin/Gradle Java 21 repository, without queueing a build. Inspect its generated-source and integration-test requirements. Keep build/package work and Testcontainers tests in two separate jobs; the package job must not execute tests. Configure generation prerequisites, verify Docker availability wherever the repository needs it, publish the application JAR from packaging and JUnit XML from tests. Select Java 21 on the agent or through a suitable build container. Do not modify repository sources.",
  "teamcity": {
    "server": "runner-configured",
    "targetProject": "runner-configured"
  },
  "repository": {
    "url": "https://github.com/usmanzaheer1995/spring-boot-demo.git",
    "revision": "940cdb0b4d15c178ca1624095e24b69914b2c9cd",
    "defaultBranch": "main",
    "root": "."
  },
  "stack": {
    "family": "spring-boot",
    "buildTool": "gradle",
    "gradle": "8.5",
    "kotlin": "1.9.21",
    "springBoot": "3.2.1"
  },
  "requestedConfiguration": {
    "format": "yaml",
    "sourcePath": ".teamcity.yml"
  },
  "agentTools": [
    "Bash",
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep"
  ],
  "expected": {
    "configurationValidated": true,
    "sourceMutations": "none",
    "minimumJobs": 2,
    "expectedJobCount": 2,
    "requiredStepTypes": [
      "gradle",
      "script"
    ],
    "requiredStepProperties": [
      {
        "stepType": "gradle",
        "property": "tasks",
        "matches": "(?i)generateJooq"
      },
      {
        "stepType": "gradle",
        "property": "tasks",
        "matches": "(?i)openApiGenerate"
      },
      {
        "stepType": "gradle",
        "property": "tasks",
        "matches": "(?i)(?:bootJar|assemble|build)"
      },
      {
        "stepType": "gradle",
        "property": "tasks",
        "matches": "(?i)(^|\\s)test(\\s|$)"
      },
      {
        "stepType": "script",
        "property": "script-content",
        "matches": "(?i)docker\\s+info"
      }
    ],
    "requiredArtifactRules": [
      "(?i)\\.jar",
      "(?i)(?:test-results|TEST-).*\\.xml"
    ],
    "requiredAgentRequirements": [
      "(?i)docker|container\\.engine"
    ],
    "requiredJobs": [
      {
        "jobMatches": "(?i)(?:build|package)",
        "requiredStepTypes": [
          "gradle",
          "script"
        ],
        "requiredStepProperties": [
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)generateJooq"
          },
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)openApiGenerate"
          },
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)(^|\\s)(bootJar|assemble)(\\s|$)"
          },
          {
            "stepType": "script",
            "property": "script-content",
            "matches": "(?m)^\\s*docker\\s+info(?:\\s|$)"
          }
        ],
        "forbiddenStepProperties": [
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)(^|\\s)(test|check|build)(\\s|$)"
          }
        ],
        "requiredArtifactRules": [
          "(?i)\\.jar"
        ],
        "requiredAgentRequirements": [
          "(?i)docker|container\\.engine"
        ]
      },
      {
        "jobMatches": "(?i)(?:test|integration)",
        "requiredStepTypes": [
          "gradle",
          "script"
        ],
        "requiredStepProperties": [
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)generateJooq"
          },
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)openApiGenerate"
          },
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)(^|\\s)test(\\s|$)"
          },
          {
            "stepType": "script",
            "property": "script-content",
            "matches": "(?m)^\\s*docker\\s+info(?:\\s|$)"
          }
        ],
        "requiredArtifactRules": [
          "(?i)(?:test-results|TEST-).*\\.xml"
        ],
        "requiredAgentRequirements": [
          "(?i)docker|container\\.engine"
        ],
        "forbiddenStepProperties": [
          {
            "stepType": "gradle",
            "property": "tasks",
            "matches": "(?i)(?:-x\\s+|--exclude-task(?:=|\\s+))(?::)?test(?=\\s|$)"
          }
        ]
      }
    ],
    "toolchain": {
      "jdk": "21"
    }
  }
}
