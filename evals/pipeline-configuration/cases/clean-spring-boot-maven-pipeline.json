{
  "schemaVersion": 1,
  "id": "clean-spring-boot-maven-pipeline",
  "kind": "pipeline-configuration",
  "status": "draft",
  "skill": "teamcity-first-green-build",
  "prompt": "Create the TeamCity pipeline configuration on {{teamcity.server}} in project {{teamcity.targetProject}} for this repository. Inspect its build and test setup, configure Maven 3.6+ verification on Java 21, publish JUnit XML and the application JAR, validate the configuration against the server, and stop there. Do not queue a build or modify repository sources. Java 21 may be selected on the agent or through a suitable build container. Keep all repository tests and Java assertions enabled.",
  "teamcity": {
    "server": "runner-configured",
    "targetProject": "runner-configured"
  },
  "repository": {
    "url": "https://github.com/kawser2133/clean-spring-boot-project.git",
    "revision": "315ca51dcb0ec25f2cce8f99fa239ec23717f3f6",
    "defaultBranch": "development",
    "root": "."
  },
  "stack": {
    "family": "spring-boot",
    "buildTool": "maven",
    "maven": "3.6+",
    "springBoot": "3.2.5"
  },
  "requestedConfiguration": {
    "format": "yaml",
    "sourcePath": ".teamcity.yml"
  },
  "agentTools": [
    "Bash",
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep"
  ],
  "expected": {
    "configurationValidated": true,
    "sourceMutations": "none",
    "minimumJobs": 1,
    "toolchain": {
      "jdk": "21"
    },
    "requiredStepTypes": [
      "maven"
    ],
    "requiredStepProperties": [
      {
        "stepType": "maven",
        "property": "goals",
        "matches": "(?i)(^|\\s)verify(\\s|$)"
      }
    ],
    "forbiddenStepProperties": [
      {
        "stepType": "maven",
        "property": "goals",
        "matches": "(?i)(?:^|\\s)[\"']?-D\\s*(?:skipTests|maven\\.test\\.skip)(?:=[\"']?true[\"']?)?(?=[\"']?(?:\\s|$))"
      },
      {
        "stepType": "maven",
        "property": "runner-arguments",
        "matches": "(?i)(?:^|\\s)[\"']?-D\\s*(?:skipTests|maven\\.test\\.skip)(?:=[\"']?true[\"']?)?(?=[\"']?(?:\\s|$))"
      },
      {
        "stepType": "maven",
        "property": "goals",
        "matches": "(?i)(?:^|\\s)[\"']?-D\\s*enableAssertions=[\"']?false[\"']?(?=[\"']?(?:\\s|$))"
      },
      {
        "stepType": "maven",
        "property": "runner-arguments",
        "matches": "(?i)(?:^|\\s)[\"']?-D\\s*enableAssertions=[\"']?false[\"']?(?=[\"']?(?:\\s|$))"
      },
      {
        "stepType": "maven",
        "property": "goals",
        "matches": "(?i)(?:^|\\s)[\"']?-D\\s*argLine=(?:[\"']?-(?:da|disableassertions)(?=[:\\s\"']|$)|\"[^\"]*\\s-(?:da|disableassertions)(?=[:\\s\"]|$)|'[^']*\\s-(?:da|disableassertions)(?=[:\\s']|$))"
      },
      {
        "stepType": "maven",
        "property": "runner-arguments",
        "matches": "(?i)(?:^|\\s)[\"']?-D\\s*argLine=(?:[\"']?-(?:da|disableassertions)(?=[:\\s\"']|$)|\"[^\"]*\\s-(?:da|disableassertions)(?=[:\\s\"]|$)|'[^']*\\s-(?:da|disableassertions)(?=[:\\s']|$))"
      },
      {
        "stepType": "maven",
        "property": "maven-version",
        "matches": "bundled-3-[0-5](?!\\d)"
      }
    ],
    "requiredArtifactRules": [
      "(?i)\\.jar",
      "(?i)(surefire-reports|TEST-).*\\.xml"
    ]
  }
}
